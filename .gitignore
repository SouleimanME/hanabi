# --- Python / backend ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Base de donnees locale (regeneree au demarrage par le seed) ---
*.db
*.sqlite
*.sqlite3

# --- Node / frontend ---
node_modules/
dist/
dist-ssr/
.vite/
*.local

# --- Secrets & environnement ---
.env
.env.*
!.env.example

# --- Editeurs / OS / outils ---
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp

# --- Orchestration ---
# Sans DAGSTER_HOME, `dagster dev` cree son stockage a cote du repertoire
# courant - qui n'est pas toujours hanabi-dwh. Le motif est donc repete ici.
.dagster/
.tmp_dagster_home_*/

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Tests de bout en bout (Playwright) ---
# Traces, captures et rapports ne sont produits qu'a l'echec, et se regenerent
# a chaque execution : les versionner alourdirait le depot sans rien apporter.
hanabi-front/test-results/
hanabi-front/playwright-report/
hanabi-front/blob-report/
hanabi-front/.playwright/

# --- Courriels ecrits localement (MAIL_BACKEND=fichier) ---
# Chaque commande, inscription ou reinitialisation depose un .eml ici. Ce sont
# des messages reels adresses a de vraies personnes : ils n'ont rien a faire
# dans un depot.
hanabi-back/var/
