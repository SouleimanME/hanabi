# Variables d'environnement de l'API Hanabi.
# Copie ce fichier en `.env` (ignoré par git) et renseigne les valeurs.

# --- Obligatoire en production ---

# Clé de signature des jetons. Avec ENV=prod, l'API refuse de démarrer sans elle ;
# en développement, une clé aléatoire est tirée à chaque lancement.
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# "dev" ou "prod"
ENV=dev

# --- Facultatif ---

# Durée de vie d'un jeton, en minutes (12 h)
# ACCESS_TOKEN_EXPIRE_MINUTES=720

# Base de données : SQLite local par défaut.
# DATABASE_URL=sqlite:///./atelier.db
# En production, PostgreSQL (`postgres://` ou `postgresql://`). Chez Neon, la
# chaîne de connexion directe, pas « pooler ». Alembic crée le schéma au démarrage.
# DATABASE_URL=postgresql://utilisateur:motdepasse@ep-xxx.us-east-2.aws.neon.tech/hanabi?sslmode=require

# Origines autorisées, séparées par des virgules (URL exacte du front en production)
# CORS_ORIGINS=https://hanabi-6x9.pages.dev

# --- Compte administrateur ---
# Sans ces deux variables, aucun administrateur n'est créé. Le mot de passe suit
# la politique des clients.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Back-office de démonstration ---
# hanabi@atelier.fr, identifiants affichés à la connexion, en lecture seule.
# DEMO_ADMIN_READONLY=0 permettrait à tout visiteur de modifier le site.
# PUBLIC_ADMIN_DEMO=1
# DEMO_ADMIN_READONLY=1

# --- Jeu de données de démonstration (app/demo_data.py) ---
# Généré une fois si la base compte moins de comptes que la cible ; 0 le désactive.
# DEMO_USERS=100000
# DEMO_VIEWS_PER_USER=7

# --- Anti-robots (app/antibot.py) ---
# Bits de zéros de la preuve de travail : 16 = environ 0,5 s sur un ordinateur
# POW_DIFFICULTY=16
# POW_TTL_SECONDS=300
# MIN_FORM_SECONDS=1.5

# --- Journalisation ---
# JSON activé d'office avec ENV=prod
# LOG_JSON=false
# LOG_LEVEL=INFO

# --- Courriels ---
# fichier (défaut) : .eml dans var/courriels/ ; smtp : relais réel ; memoire : tests
# MAIL_BACKEND=fichier
# MAIL_FROM=commandes@hanabi.example
# MAIL_FROM_NAME=Hanabi

# Racine publique de la boutique (pas de l'API), utilisée dans les liens des courriels
# PUBLIC_SITE_URL=http://localhost:5173

# --- Relais SMTP, si MAIL_BACKEND=smtp ---
#   Brevo    SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587
#   Resend   SMTP_HOST=smtp.resend.com       SMTP_PORT=587   SMTP_USER=resend
#   Gmail    SMTP_HOST=smtp.gmail.com        SMTP_PORT=587   (mot de passe d'application)
# Port 587 : STARTTLS ; port 465 : TLS dès l'ouverture.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true
# SMTP_TIMEOUT=10

# --- File des courriels ---
# 0 désactive la tâche de fond
# OUTBOX_INTERVALLE_SECONDES=5
# OUTBOX_LOT=20
# OUTBOX_TENTATIVES_MAX=5

# --- Idempotence ---
# IDEMPOTENCE_RETENTION_HEURES=24
