# Variables d'environnement de l'API Hanabi.
# Copie ce fichier en `.env` et renseigne les valeurs. `.env` est ignore par git.

# --- OBLIGATOIRE EN PRODUCTION ---
#
# Cle de signature des jetons d'authentification. Aucune valeur par defaut n'est
# fournie dans le code, volontairement : une cle presente dans le depot est une
# cle publique, et permettrait de forger un jeton pour n'importe quel compte,
# administrateur compris.
#
# Avec ENV=prod, l'API refuse de demarrer si cette variable est absente.
# En developpement, une cle aleatoire est tiree a chaque lancement (les jetons
# ne survivent alors pas a un redemarrage).
#
# Genere une cle avec :
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# "dev" ou "prod". En prod, SECRET_KEY devient obligatoire.
ENV=dev

# --- Optionnel : les valeurs par defaut conviennent en local ---

# Duree de vie d'un jeton, en minutes. 12 h par defaut : le jeton est stocke en
# localStorage, donc lisible par un script injecte, ce qui plaide pour une
# fenetre courte.
# ACCESS_TOKEN_EXPIRE_MINUTES=720

# Base de donnees.
#
# Par defaut, un fichier SQLite local : rien a installer pour developper.
# DATABASE_URL=sqlite:///./atelier.db
#
# En production, une chaine PostgreSQL. Les deux formes suivantes sont
# acceptees, le pilote est ajoute automatiquement :
#   postgres://...    (forme historique servie par certains hebergeurs)
#   postgresql://...
#
# Exemple Neon, en prenant la chaine de connexion DIRECTE du tableau de bord
# (pas la variante « pooler ») : le gestionnaire de connexions ne conserve pas
# l'etat de session, dont depend le fuseau force a UTC.
# DATABASE_URL=postgresql://utilisateur:motdepasse@ep-xxx.us-east-2.aws.neon.tech/hanabi?sslmode=require
#
# Le schema est cree et fait evoluer par Alembic au demarrage : il n'y a rien
# a executer a la main sur une base neuve.

# Origines autorisees a appeler l'API, separees par des virgules.
# En production, l'URL exacte du front, protocole inclus. Sans cela, le
# navigateur bloque tous les appels.
# CORS_ORIGINS=https://hanabi.netlify.app

# --- Compte administrateur ---
#
# Sans ces deux variables, AUCUN administrateur n'est cree et le back-office
# reste inaccessible : c'est le defaut voulu, pour qu'une mise en ligne
# distraite n'ouvre pas l'administration.
#
# Le compte de demonstration (demo@hanabi.fr), dont les identifiants sont
# affiches dans la fenetre de connexion, est un client SANS privileges.
#
# Le mot de passe est soumis a la meme politique que celle des clients : trop
# court ou trop courant, il est refuse et aucun compte n'est cree.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Back-office vitrine ---
#
# Compte administrateur aux identifiants publics (hanabi@atelier.fr), affiche
# dans la fenetre de connexion sous le compte client. Il permet a un visiteur
# d'ouvrir le back-office sans qu'on lui transmette quoi que ce soit.
#
# Puisque n'importe qui peut s'y connecter, il est bride en lecture seule : il
# consulte tout, il ne modifie rien. Passer DEMO_ADMIN_READONLY a 0 lui rend
# les droits complets, ce qui revient a autoriser tout visiteur a supprimer des
# produits et a promouvoir des comptes. A ne faire qu'en connaissance de cause.
# PUBLIC_ADMIN_DEMO=1
# DEMO_ADMIN_READONLY=1

# --- Jeu de donnees de demonstration (voir app/demo_data.py) ---
#
# Population fictive generee au demarrage si la base compte moins de comptes que
# la cible. Sans elle, le tableau de bord analytique n'a rien a montrer : un
# taux de conversion calcule sur deux commandes ne veut rien dire.
#
# La generation prend quelques secondes et n'a lieu qu'une fois par base. A 0,
# rien n'est genere et la base se limite au catalogue.
# DEMO_USERS=10000

# Consultations de fiche generees par compte. Determine la taille de la table
# la plus volumineuse du schema, donc la duree du demarrage.
# DEMO_VIEWS_PER_USER=7

# --- Anti-robots (voir app/antibot.py) ---

# Bits de zeros exiges sur l'empreinte de la preuve de travail. Chaque bit
# supplementaire double le cout pour le client. 16 demande environ une demi-
# seconde sur un ordinateur de bureau, quelques secondes sur un telephone
# d'entree de gamme.
# POW_DIFFICULTY=16

# Duree de validite d'un defi, en secondes.
# POW_TTL_SECONDS=300

# Delai minimal entre l'affichage d'un formulaire et son envoi, en secondes.
# MIN_FORM_SECONDS=1.5
